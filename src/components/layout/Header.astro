---
import { SITE } from "@/lib/site";
import { SearchCommand } from "./SearchCommand";
import { ThemeToggle } from "./ThemeToggle";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(href + "/");
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <div
    class="container mx-auto flex h-14 max-w-2xl items-center justify-between px-4"
  >
    <a href="/" class="font-semibold">
      {SITE.name}
    </a>
    <nav
      class="flex flex-wrap items-center gap-2 sm:gap-6"
      aria-label="Main navigation"
    >
      <a
        href="/articles"
        class:list={[
          "text-sm transition-colors hover:text-foreground",
          isActive("/articles") ? "text-foreground" : "text-muted-foreground",
        ]}
      >
        Articles
      </a>
      <a
        href="/tags"
        class:list={[
          "text-sm transition-colors hover:text-foreground",
          isActive("/tags") ? "text-foreground" : "text-muted-foreground",
        ]}
      >
        Tags
      </a>
      <a
        href="/about"
        class:list={[
          "text-sm transition-colors hover:text-foreground",
          isActive("/about") ? "text-foreground" : "text-muted-foreground",
        ]}
      >
        About
      </a>
      <div class="flex items-center gap-1">
        <SearchCommand client:load />
        <ThemeToggle client:load />
      </div>
    </nav>
  </div>
</header>
